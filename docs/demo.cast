[0.005801, "o", "\r\n  workers-mcp-starter  —  local demo (no login, no deploy)\r\n\r\n"]
[1.207288, "o", "$ npm test\r\n"]
[1.303172, "o", "\r\n> workers-mcp-starter@1.0.0 test\r\n> node --test tests/*.test.mjs\r\n\r\n"]
[1.396489, "o", "✔ repo contains the starter files (0.800631ms)\r\n"]
[1.402256, "o", "✔ README has the Pro upsell and MIT is present (1.169493ms)\r\n✔ no forbidden payment-rail, wallet, or identity terms (2.141193ms)\r\n"]
[1.434242, "o", "✔ GET /health returns ok and the service name (26.601017ms)\r\n✔ GET / points at POST /mcp (0.693808ms)\r\n"]
[1.434277, "o", "✔ GET /mcp is 405 with a hint (0.987234ms)\r\n"]
[1.434396, "o", "✔ initialize returns a supported protocol version and serverInfo (1.509187ms)\r\n✔ notifications/initialized returns 202 (0.636288ms)\r\n"]

[2.861627, "o", "\r\n$ npx wrangler dev --local --port 8799\r\n"]
[4.355664, "o", "Ready on http://127.0.0.1:8799\r\n"]
[5.356915, "o", "\r\n$ curl -sS http://127.0.0.1:8799/health\r\n"]
[5.370949, "o", "{\"ok\":true,\"service\":\"workers-mcp-starter\"}"]
[5.371617, "o", "\r\n"]
[6.373033, "o", "\r\n$ curl -sS http://127.0.0.1:8799/mcp  -H content-type:application/json  -d '{initialize...}'\r\n"]
[6.385363, "o", "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"protocolVersion\":\"2025-03-26\",\"capabilities\":{\"tools\":{\"listChanged\":false}},\"serverInfo\":{\"name\":\"workers-mcp-starter\",\"version\":\"1.0.0\"},\"instructions\":\"A small example server. The only tool is page_title. Replace it in src/tools.js (search for REPLACE THIS).\"}}"]
[6.386059, "o", "\r\n"]
[7.587415, "o", "\r\n$ curl -sS ... tools/call page_title url=https://example.com\r\n"]
[7.684953, "o", "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"ok\\\":true,\\\"url\\\":\\\"https://example.com/\\\",\\\"title\\\":\\\"Example Domain\\\"}\"}],\"isError\":false}}"]
[7.686089, "o", "\r\n"]
[9.087441, "o", "\r\nThat is the local path. Deploy is wrangler deploy, on your own account.\r\n\r\n"]
